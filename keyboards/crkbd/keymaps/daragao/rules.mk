WPM_ENABLE = yes  # Enable word per minute counter
LTO_ENABLE = yes  # Makes hex file smaller
OLED_ENABLE = yes # Enable OLEDs
# Enable Mouse Keys support
MOUSEKEY_ENABLE = yes

# Enable RGB Lighting support (for keys like RGB_TOG, RGB_HUI, etc.)
# This is usually for QMK's built-in RGB light support (rgblight)
RGBLIGHT_ENABLE = yes

SRC += animation-utils.c
